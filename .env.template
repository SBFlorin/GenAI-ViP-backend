# Copy to .env and replace all local-only sample settings before starting.
PORT=3000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=
# Optional. Leave empty to use the project associated with OPENAI_API_KEY.
OPENAI_PROJECT_ID=
# Comma-separated list of allowed browser origins. Required in production.
CORS_ORIGIN=http://localhost:5173
SQLITE_STORAGE=./storage/database.sqlite
LOG_LEVEL=info
# Optional voice-module settings in the October 2026 pre-Study-5 source snapshot.
OPENAI_VOICE_MODE=realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VOICE_FEMALE=marin
OPENAI_REALTIME_VOICE_MALE=cedar
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
